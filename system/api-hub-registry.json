{
  "$schema_note": "AAROHI Universal API Hub — curated index, NOT an install list. Prefer existing MCP Hub + Models openai-compat over cloning repos.",
  "version": "1.0.0",
  "updated": "2026-11-01",
  "project": "AAROHI",
  "principles": [
    "Reuse MCP Hub / Connections before adding SDKs",
    "openai-compat covers LiteLLM / vLLM / any OpenAI-compatible gateway",
    "Never mark an API free without verifying terms",
    "Do not clone every repo — index + selective adapters only",
    "Secrets stay in env / Models UI — never frontend"
  ],
  "existing_aarohi_owners": {
    "orchestration": "server/main.py + engines",
    "tools_mcp": "server/mcp_hub.py + mcp_store",
    "llm_brains": "Models page + apply_model_env + system/free-llm-presets.json",
    "channels": "Telegram / Discord / Slack / Zalo / WhatsApp modules",
    "voice": "Edge TTS (Swara Hindi default) + voice_brain / voice_live",
    "auth": "server auth + settings.json",
    "vault_memory": "brains/ vault"
  },
  "implementation_priority": [
    {"rank": 1, "component": "API discovery index", "repo": "public-apis/public-apis", "aarohi_action": "catalog only — this registry"},
    {"rank": 2, "component": "OpenAPI specs", "repo": "APIs-guru/openapi-directory", "aarohi_action": "future OpenAPI→MCP generator; not installed yet"},
    {"rank": 3, "component": "Unified AI gateway", "repo": "BerriAI/litellm", "aarohi_action": "optional self-host; point Models → openai-compat at LiteLLM /v1"},
    {"rank": 4, "component": "Agent connectors", "repo": "composiohq/composio | oomol-lab/openconnector", "aarohi_action": "prefer MCP Servers pack; Composio only if MCP gap"},
    {"rank": 5, "component": "Tool protocol", "repo": "modelcontextprotocol/python-sdk", "aarohi_action": "ALREADY via mcp_hub"},
    {"rank": 6, "component": "Workflow automation", "repo": "n8n-io/n8n", "aarohi_action": "external optional; AAROHI loops/workflows cover many cases"},
    {"rank": 7, "component": "Database/memory", "repo": "supabase/supabase", "aarohi_action": "optional; vault + settings.json is SoT today"},
    {"rank": 8, "component": "API security/secrets", "repo": "Infisical/infisical", "aarohi_action": "use Vercel/env secrets; Infisical optional later"},
    {"rank": 9, "component": "Monitoring", "repo": "prometheus/grafana", "aarohi_action": "optional ops; not required for girlfriend OS"},
    {"rank": 10, "component": "API testing", "repo": "Orange-OpenSource/hurl", "aarohi_action": "dev tooling only"}
  ],
