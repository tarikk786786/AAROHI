WORKSPACE_NAME=AAROHI
USER_NAME=Babe
# Dashboard login (Vercel auto-seeds Tarik / 8984 if these are empty)
JAVIS_ADMIN_USER=Tarik
JAVIS_ADMIN_PASSWORD=8984
JAVIS_REQUIRE_LOGIN=1
# AAROHI_DEFAULT_LOGIN=1
# Sweet romantic Hindi girlfriend voice (Edge TTS, free). Alternatives:
#   hi-IN-SwaraNeural   = soft Hindi girl (default)
#   en-IN-NeerjaNeural  = sweet Indian English / Hinglish
#   en-US-AvaMultilingualNeural = multilingual expressive
# Soft Indian girlfriend voice (Edge free). Prefer Indic-Speak Kavya after scripts/install-aarohi-voice.ps1
TTS_VOICE=hi-IN-SwaraNeural
TTS_RATE=-8%
# HF_TOKEN=hf_...          # gated Indic-Speak download
# INDIC_SPEAK_SPEAKER=Kavya
# NEEDLE_TELEMETRY=0       # Shruti / cactus-needle
# Optional companion roster (Grok Bot–style agents): https://github.com/milind-soni/OpenMausBot

# OpenRouter = swappable / fallback brain when Claude/Codex/etc deny or run out of quota.
# Get a key at https://openrouter.ai/keys then either:
#   PowerShell:  $env:OPENROUTER_API_KEY="sk-or-v1-..."
#   bash:        export OPENROUTER_API_KEY=sk-or-v1-...
#   Vercel:      Project → Settings → Environment Variables
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Set to 1 if env should always overwrite a key already saved in Models UI
# JAVIS_ENV_KEYS_OVERRIDE=0

# Free LLM APIs (curated): https://github.com/mnfst/awesome-free-llm-apis
# See system/free-llm-presets.json for base URLs + models.
GROQ_API_KEY=
GEMINI_API_KEY=
# Free always-on brain (NO key). Leave OPENAI_COMPAT_KEY empty — a revoked key causes 401.
# Failover: OVH anonymous → then Groq/Gemini/OpenRouter if you add free keys below.
FREE_LLM_PRESET=llm7
OPENAI_COMPAT_BASE=https://api.llm7.io/v1
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=turbo
# Optional free-tier keys (raise limits; never commit real keys):
# GROQ_API_KEY=          https://console.groq.com/keys
# GEMINI_API_KEY=        https://aistudio.google.com/app/apikey
# OPENROUTER_API_KEY=    https://openrouter.ai/keys
# Optional LLM7 free token (not required): https://token.llm7.io
