WORKSPACE_NAME=AAROHI
USER_NAME=Babe
TTS_VOICE=en-US-AvaMultilingualNeural
TTS_RATE=+5%
# Optional companion roster (Grok Bot–style agents): https://github.com/milind-soni/OpenMausBot

# OpenRouter = swappable / fallback brain when Claude/Codex/etc deny or run out of quota.
# Get a key at https://openrouter.ai/keys then either:
#   PowerShell:  $env:OPENROUTER_API_KEY="sk-or-v1-..."
#   bash:        export OPENROUTER_API_KEY=sk-or-v1-...
#   Vercel:      Project → Settings → Environment Variables
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Set to 1 if env should always overwrite a key already saved in Models UI
# JAVIS_ENV_KEYS_OVERRIDE=0
